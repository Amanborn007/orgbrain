# OrgBrain — sample environment.
#
# Copy to `.env` and adjust values for your environment. `.env` is
# gitignored; never commit real credentials.
#
# Pydantic-settings loads keys with the prefix ORGBRAIN_ — e.g.
# ORGBRAIN_DATABASE_URL maps to OrgBrainSettings.database_url.

# ── Database ──────────────────────────────────────────────────────
# Local dev: peer-auth Postgres or matching docker-compose.yml.
# Production: rotate from Vault or AWS Secrets Manager; never inline.
ORGBRAIN_DATABASE_URL=postgresql+asyncpg://orgbrain:orgbrain_dev@localhost:5432/orgbrain

# ── API server ────────────────────────────────────────────────────
ORGBRAIN_API_BASE_URL=http://localhost:8000

# ── Logging ───────────────────────────────────────────────────────
ORGBRAIN_LOG_LEVEL=INFO

# ── Claude CLI subprocess ─────────────────────────────────────────
# Auth comes from `claude auth login` (your Claude login). No API key here.
ORGBRAIN_CLAUDE_CLI_PATH=claude
ORGBRAIN_CLAUDE_CLI_TIMEOUT_SECONDS=600

# ── Models ────────────────────────────────────────────────────────
ORGBRAIN_TRIAGE_MODEL=claude-opus-4-8
ORGBRAIN_EXTRACTION_MODEL=claude-sonnet-4-6
ORGBRAIN_AGENT_MODEL=claude-sonnet-4-6
ORGBRAIN_REASONING_MODEL=claude-opus-4-8

# ── Extraction worker ─────────────────────────────────────────────
ORGBRAIN_MAX_CONCURRENT_EXTRACTIONS=1
ORGBRAIN_CHECKPOINT_DIR=/tmp/orgbrain-checkpoints
ORGBRAIN_CLONE_DIR=/tmp/orgbrain-clones
ORGBRAIN_EXTRACTION_DRY_RUN=false

# ── CLI / CI token ────────────────────────────────────────────────
# The CLI sends this as ``Authorization: Bearer``. Mint one with
# ``orgbrain token new`` and list its sha256 under ``api_tokens`` in
# orgbrain.yaml on the server.
ORGBRAIN_TOKEN=

# ── External integrations (optional) ──────────────────────────────
# Jira — required if you want the action layer to enrich briefs from
# Jira links in user input.
ORGBRAIN_SOURCES__JIRA__BASE_URL=
ORGBRAIN_SOURCES__JIRA__EMAIL=
ORGBRAIN_SOURCES__JIRA__API_TOKEN=

# ── Process-environment only ──────────────────────────────────────
# These are read from the process environment, not from this file, and
# startup rejects them here. Export them in the shell that starts OrgBrain:
#   ORGBRAIN_DISABLE_AUTO_ARCHIVE=1   disable the scheduled archive job
#   ORGBRAIN_EMBEDDING_CACHE=<dir>    embedding model cache folder

# ── Production-strict startup ────────
# When true the app refuses to start if any prod-required secret is
# missing or still on a local-dev default. Set this in any
# deployment that serves real users. Local dev / CI / demo runs
# leave it false (the default).
#
# Required when true:
#   * ORGBRAIN_SESSION_SIGNING_KEY (stable HMAC key)
#   * ORGBRAIN_DATABASE_URL (NOT the localhost default)
#   * ORGBRAIN_CORS_ORIGINS (NOT the localhost default)
#   * identity.provider=header with identity.trusted_proxy=true
#     OR identity.provider=oidc_jwt (see orgbrain.example.yaml).
#   * ORGBRAIN_DEMO_MODE must NOT be true.
ORGBRAIN_PRODUCTION_MODE=false

# ── Identity provider ──────────────────────────────────────────────
# Set these under ``identity:`` in orgbrain.yaml, or as env vars.
#   ORGBRAIN_IDENTITY__PROVIDER=none | header | oidc_jwt
#
# none (the local operator, loopback clients only):
#   ORGBRAIN_OPERATOR_EMAIL=you@example.com
#   ORGBRAIN_OPERATOR_GROUPS=eng,ops
#
# header (a reverse proxy supplies the identity headers):
#   ORGBRAIN_IDENTITY__PROVIDER=header
#   ORGBRAIN_IDENTITY__TRUSTED_PROXY=true
#
# oidc_jwt (verify bearer JWTs against the IdP signing keys):
#   ORGBRAIN_IDENTITY__PROVIDER=oidc_jwt
#   ORGBRAIN_IDENTITY__OIDC__JWKS_URL=https://idp.example.com/.well-known/jwks.json
#   ORGBRAIN_IDENTITY__OIDC__ISSUER=https://idp.example.com
#   ORGBRAIN_IDENTITY__OIDC__AUDIENCE=orgbrain
#
# header and oidc_jwt also need identity.roles (group -> role map) in
# orgbrain.yaml.
